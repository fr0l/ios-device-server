{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "timeouts": {
      "type": "object",
      "properties": {
        "device": { "type": ["integer", "null"] }
      }
    },
    "ci": { "description": "Set by the CI deployment: base simulators must exist, and with no devices.configured every attached device is used. Off (laptops): missing base simulators are created, only configured devices are used.", "type": "boolean" },
    "public_host": {
      "description": "Host name or IP returned to clients. Defaults to the first local IP.",
      "type": "string"
    },
    "simulators": {
      "description": "Omit to disable simulators.",
      "type": "object",
      "properties": {
        "limit": { "type": "integer" },
        "concurrent_boots": { "type": "integer" },
        "disabled_services": { "type": "array", "items": { "type": "string" } },
        "shutdown_simulators": { "type": "boolean" }
      }
    },
    "devices": {
      "description": "Omit to disable physical devices.",
      "type": "object",
      "properties": {
        "whitelist_apps": { "type": "array", "items": { "type": "string" } },
        "uninstall_apps": { "type": "boolean" },
        "configured": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "udid": { "type": "string" } },
            "required": ["udid"]
          }
        }
      }
    },
    "health": {
      "description": "GET /status/health probes. Every field is optional.",
      "type": "object",
      "properties": {
        "refresh_seconds": { "type": "integer" },
        "probe_urls": { "description": "URLs probed for DNS, TCP connect and HTTP time to first byte.", "type": "array", "items": { "type": "string" } },
        "ntp_server": { "type": "string" },
        "expected_subnets": { "description": "CIDRs the primary interface must be in.", "type": "array", "items": { "type": "string" } },
        "expected_xcode_version": { "type": "string" },
        "thresholds": {
          "description": "Per check {\"degraded\": n, \"failing\": n}; a check without \"failing\" can only degrade the host.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "degraded": { "type": ["number", "null"] }, "failing": { "type": ["number", "null"] } }
          }
        }
      }
    }
  }
}
